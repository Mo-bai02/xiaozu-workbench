# 模型服务配置
# 复制为 .env 后填 Key。填了哪个供应商的 Key，下拉里就会出现对应的模型。
# 一个都不填 → 走内置 mock，页面依然能跑通全流程。

# ---------- DeepSeek（便宜，国内直连）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 硅基流动（有免费模型：Qwen2.5-7B / GLM-4-9B）----------
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 智谱（glm-4-flash 免费）----------
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---------- 通义千问（阿里云百炼）----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 兜底：只配这一个也行，会被 DeepSeek 使用
LLM_API_KEY=

# 服务端口
PORT=8787
