{
  "name": "ai-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "工作台：项目概览 / 任务看板 / 成员管理 + AI 助手（流式对话、表单生成、调用记录）",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:api\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "api": "node server/index.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.1",
    "antd": "5.21.6",
    "dompurify": "3.1.7",
    "marked": "14.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "zod": "3.23.8",
    "zustand": "4.5.5",
    "dayjs": "1.11.13"
  },
  "devDependencies": {
    "@eslint/js": "9.10.0",
    "@types/dompurify": "3.0.5",
    "@types/node": "22.5.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "9.0.1",
    "eslint": "9.10.0",
    "jsdom": "25.0.1",
    "prettier": "3.3.3",
    "typescript": "5.6.2",
    "typescript-eslint": "8.6.0",
    "vite": "5.4.8",
    "vitest": "2.1.1"
  }
}
